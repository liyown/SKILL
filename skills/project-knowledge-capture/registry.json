          "target": "~/.skills/project-knowledge-capture/agents/openai.yaml"
        },
        {
          "path": "prompts/capture.md",
          "type": "registry:file",
          "target": "~/.skills/project-knowledge-capture/prompts/capture.md"
        },
        {
          "path": "examples/knowledge-note.md",
