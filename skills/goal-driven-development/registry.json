{
  "$schema": "https://ui.shadcn.com/schema/registry.json",
  "items": [
    {
      "name": "goal-driven-development",
      "type": "registry:item",
      "title": "Goal Driven Development Skill",
      "description": "CodeGraph-assisted development workflow for implementing existing goals or specs, verifying changes, running code review gates, and capturing durable project knowledge.",
      "registryDependencies": [
        "liyown/skills-registry/java-code-reviewer#v0.2.0",
        "liyown/skills-registry/react-code-reviewer#v0.2.0",
        "liyown/skills-registry/project-knowledge-capture#v0.2.0"
      ],
      "files": [
        {
          "path": "README.md",
          "type": "registry:file",
          "target": "~/.skills/goal-driven-development/README.md"
        },
        {
          "path": "SKILL.md",
          "type": "registry:file",
          "target": "~/.skills/goal-driven-development/SKILL.md"
        },
        {
          "path": "manifest.json",
          "type": "registry:file",
          "target": "~/.skills/goal-driven-development/manifest.json"
        },
        {
          "path": "agents/openai.yaml",
          "type": "registry:file",
          "target": "~/.skills/goal-driven-development/agents/openai.yaml"
        },
        {
          "path": "prompts/workflow.md",
          "type": "registry:file",
          "target": "~/.skills/goal-driven-development/prompts/workflow.md"
        },
        {
          "path": "prompts/codegraph.md",
          "type": "registry:file",
          "target": "~/.skills/goal-driven-development/prompts/codegraph.md"
        },
        {
          "path": "examples/workflow-note.md",
          "type": "registry:file",
          "target": "~/.skills/goal-driven-development/examples/workflow-note.md"
        }
      ]
    }
  ]
